<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F6E9"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/menuButtonsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pac"
            android:text="2048"
            android:textColor="#706B5F"
            android:textSize="80sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_menubuttoncontainer"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continiobtn"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/jungleadvantures"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="#706B5F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#EBE3CB"
            app:cornerRadius="14dp"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="#FFFFFF"
            app:strokeColor="#2A2A35"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startbtn"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/jungleadvantures"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="New Game"
            android:textAllCaps="false"
            android:textColor="#706B5F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#EBE3CB"
            app:cornerRadius="14dp"
            app:strokeColor="#2A2A35"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/infobtn"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#EBE3CB"
            android:fontFamily="@font/jungleadvantures"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Info"
            android:textAllCaps="true"
            android:textColor="#706B5F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#2A2A35"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sharebtn"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#EBE3CB"
            android:fontFamily="@font/jungleadvantures"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Exit"
            android:textAllCaps="false"
            android:textColor="#706B5F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#2A2A35"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>